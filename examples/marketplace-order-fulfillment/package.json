{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@likego/example-marketplace-order-fulfillment",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run --cwd ../.. build && bun run start:prepared",
    "start:prepared": "bun build src/main.ts --target=node --outfile=.artifacts/main.mjs && node .artifacts/main.mjs",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test",
    "test:unit:coverage": "bun test --isolate --no-orphans test --coverage --coverage-dir .artifacts/coverage",
    "test:e2e": "bun ../../e2e/example-task.ts -- bun ../../e2e/example.ts"
  },
  "dependencies": {
    "@likego/context": "workspace:*",
    "@likego/core": "workspace:*",
    "@likego/web": "workspace:*"
  },
  "license": "MIT"
}
