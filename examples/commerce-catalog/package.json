{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@likego/example-commerce-catalog",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run --cwd ../.. build:packages && bun run start:prepared",
    "start:prepared": "bun build src/main.ts --target=node --outfile=.artifacts/main.mjs && node .artifacts/main.mjs",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "bun test --isolate --no-orphans test/*.test.ts",
    "test:coverage": "bun test --isolate --no-orphans test/*.test.ts --coverage --coverage-reporter=lcov --coverage-dir .artifacts/coverage",
    "test:docker": "bun e2e/docker.ts"
  },
  "dependencies": {
    "@likego/cache": "workspace:*",
    "@likego/cache-redis": "workspace:*",
    "@likego/client": "workspace:*",
    "@likego/context": "workspace:*",
    "@likego/core": "workspace:*",
    "@likego/health": "workspace:*",
    "@likego/hono": "workspace:*",
    "@likego/registry": "workspace:*",
    "@likego/registry-consul": "workspace:*",
    "@likego/resilience": "workspace:*",
    "@likego/server": "workspace:*",
    "@likego/transport": "workspace:*",
    "@likego/transport-http": "workspace:*",
    "@likego/web": "workspace:*",
    "hono": "4.12.32"
  },
  "devDependencies": {
    "@likego/cache-memory": "workspace:*",
    "@types/node": "26.1.1"
  },
  "license": "MIT"
}
