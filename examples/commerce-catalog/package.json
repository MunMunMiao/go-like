{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/example-commerce-catalog",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run --cwd ../.. build && bun run start:prepared",
    "start:prepared": "bun build src/main.ts --target=node --outfile=.artifacts/main.mjs && node .artifacts/main.mjs",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test/*.test.ts",
    "test:unit:coverage": "bun test --isolate --no-orphans test/*.test.ts --coverage --coverage-dir .artifacts/coverage",
    "test:e2e": "bun ../../e2e/example-task.ts -- bun e2e/docker.ts"
  },
  "dependencies": {
    "@go-like/redis": "workspace:*",
    "@go-like/core": "workspace:*",
    "@go-like/consul": "workspace:*",
    "hono": "4.13.18"
  },
  "devDependencies": {
    "@types/node": "26.6.6"
  },
  "license": "MIT"
}
