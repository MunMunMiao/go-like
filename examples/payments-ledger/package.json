{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/example-payments-ledger",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run --cwd ../.. build && bun run start:prepared",
    "start:prepared": "bun src/main.ts",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test/*.test.ts",
    "test:unit:coverage": "bun ../../e2e/example-task.ts -- bun test --isolate --no-orphans test/*.test.ts test/integration --coverage --coverage-dir .artifacts/coverage",
    "test:e2e": "bun ../../e2e/example-task.ts -- bun e2e/docker.ts"
  },
  "dependencies": {
    "@go-like/context": "workspace:*",
    "@go-like/core": "workspace:*",
    "@go-like/web": "workspace:*",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0"
  },
  "license": "MIT"
}
