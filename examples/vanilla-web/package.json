{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@likego/example-vanilla-web",
  "private": true,
  "description": "Vanilla standard Fetch handler composed with the LikeGo Node host.",
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "start": "bun run --cwd ../.. build:packages && bun run start:prepared",
    "start:prepared": "bun build src/main.ts --target=node --outfile=.artifacts/main.mjs && node .artifacts/main.mjs",
    "e2e:node": "bun run --cwd ../.. build:packages && bun run e2e:node:prepared",
    "e2e:node:prepared": "tsx test/node-e2e.ts",
    "test": "bun test --isolate --no-orphans test",
    "test:coverage": "bun test --isolate --no-orphans test --coverage --coverage-dir .artifacts/coverage",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "@likego/context": "workspace:*",
    "@likego/core": "workspace:*",
    "@likego/web": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.1.1"
  },
  "license": "MIT"
}
