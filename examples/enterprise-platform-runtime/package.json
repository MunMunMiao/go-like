{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/example-enterprise-platform-runtime",
  "private": true,
  "description": "Consul, Vault, internal HTTP, telemetry, health, metrics, and logging example.",
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "start": "bun run --cwd ../.. build && bun run start:prepared",
    "start:prepared": "bun build src/main.ts --target=node --outfile=.artifacts/main.mjs && node .artifacts/main.mjs",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test/unit",
    "test:unit:coverage": "bun test --isolate --no-orphans test/unit --coverage --coverage-dir .artifacts/coverage",
    "test:e2e": "bun ../../e2e/example-task.ts -- bunx --no-install tsx test/e2e/docker-e2e.ts"
  },
  "dependencies": {
    "@go-like/client": "workspace:*",
    "@go-like/config": "workspace:*",
    "@go-like/config-vault": "workspace:*",
    "@go-like/context": "workspace:*",
    "@go-like/core": "workspace:*",
    "@go-like/health": "workspace:*",
    "@go-like/otel": "workspace:*",
    "@go-like/pino": "workspace:*",
    "@go-like/prometheus": "workspace:*",
    "@go-like/registry": "workspace:*",
    "@go-like/registry-consul": "workspace:*",
    "@go-like/server": "workspace:*",
    "@go-like/store-vault": "workspace:*",
    "@go-like/transport": "workspace:*",
    "@go-like/transport-http": "workspace:*",
    "@go-like/web": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.10.0",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-trace": "2.10.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2"
  },
  "license": "MIT"
}
