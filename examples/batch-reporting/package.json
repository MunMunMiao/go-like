{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@likego/example-batch-reporting",
  "private": true,
  "description": "Croner, BullMQ, Redis, and File Store batch-reporting example.",
  "type": "module",
  "scripts": {
    "start": "bun run --cwd ../.. build && bun run start:prepared",
    "start:prepared": "bun build src/main.ts --target=node --outfile=.artifacts/main.mjs && node .artifacts/main.mjs",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test/unit",
    "test:unit:coverage": "bun test --isolate --no-orphans test/unit --coverage --coverage-dir .artifacts/coverage",
    "test:e2e": "bun ../../e2e/example-task.ts -- bun test/e2e/docker-e2e.ts"
  },
  "dependencies": {
    "@likego/bullmq": "workspace:*",
    "@likego/context": "workspace:*",
    "@likego/core": "workspace:*",
    "@likego/croner": "workspace:*",
    "@likego/store": "workspace:*",
    "@likego/store-file": "workspace:*",
    "bullmq": "5.81.2",
    "croner": "10.0.1"
  },
  "devDependencies": {
    "@types/node": "26.1.1"
  },
  "license": "MIT"
}
