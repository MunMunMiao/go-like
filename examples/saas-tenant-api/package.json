{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/example-saas-tenant-api",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run --cwd ../.. build && bun run start:prepared",
    "start:prepared": "bun build src/main.ts --target=node --outfile=.artifacts/main.mjs && node .artifacts/main.mjs",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test/*.test.ts",
    "test:unit:coverage": "bun test --isolate --no-orphans test/*.test.ts --coverage --coverage-reporter=lcov --coverage-dir .artifacts/coverage",
    "test:e2e": "bun ../../e2e/example-task.ts -- bun e2e/docker.ts"
  },
  "dependencies": {
    "@go-like/cache": "workspace:*",
    "@go-like/cache-redis": "workspace:*",
    "@go-like/config": "workspace:*",
    "@go-like/config-consul": "workspace:*",
    "@go-like/context": "workspace:*",
    "@go-like/core": "workspace:*",
    "@go-like/pino": "workspace:*",
    "@go-like/resilience": "workspace:*",
    "@go-like/store-consul": "workspace:*",
    "@go-like/web": "workspace:*",
    "hono": "4.12.34",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@go-like/cache-memory": "workspace:*",
    "@types/node": "26.1.2"
  },
  "license": "MIT"
}
