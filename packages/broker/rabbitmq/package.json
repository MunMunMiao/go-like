{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/broker-rabbitmq",
  "version": "0.0.1",
  "description": "RabbitMQ AMQP 0-9-1 Broker provider for go-like.",
  "type": "module",
  "module": "src/index.ts",
  "typings": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.test.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test/*.test.ts",
    "test:unit:coverage": "bun test --isolate --no-orphans test/*.test.ts --coverage --coverage-dir .artifacts/coverage",
    "test:e2e": "bun test/e2e/rabbitmq-docker-e2e.ts"
  },
  "dependencies": {
    "@go-like/broker": "0.0.1",
    "@go-like/context": "0.0.1",
    "@go-like/core": "0.0.1",
    "@types/node": "26.4.0",
    "amqplib": "2.0.1"
  },
  "license": "MIT"
}
