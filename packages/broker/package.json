{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@likego/broker",
  "version": "0.0.1",
  "description": "Portable byte broker contracts and Core subscription lifecycle adapter for LikeGo.",
  "type": "module",
  "module": "src/index.ts",
  "typings": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./provider": "./src/provider.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "test": "bun test --isolate --no-orphans test/*.test.ts",
    "test:coverage": "bun test --isolate --no-orphans test/*.test.ts --coverage --coverage-reporter=lcov --coverage-dir .artifacts/coverage && bun test/coverage-contract.ts",
    "typecheck": "tsc -p tsconfig.test.json --pretty false"
  },
  "dependencies": {
    "@likego/context": "0.0.1",
    "@likego/core": "0.0.1"
  },
  "license": "MIT"
}
