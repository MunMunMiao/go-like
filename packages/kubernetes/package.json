{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/kubernetes",
  "version": "0.0.1",
  "description": "Kubernetes registry and configuration plugs for go-like.",
  "type": "module",
  "module": "src/index.ts",
  "typings": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./registry": "./src/registry/index.ts",
    "./config": "./src/config/index.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.test.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test/**/*.test.ts",
    "test:unit:coverage": "bun test --isolate --no-orphans test/**/*.test.ts --coverage --coverage-dir .artifacts/coverage",
    "test:e2e:registry": "bun test/registry/e2e/k3s-docker.ts",
    "test:e2e:config": "bun test/config/e2e/k3s-docker.ts"
  },
  "peerDependencies": {
    "@go-like/core": "0.0.1"
  },
  "devDependencies": {
    "@go-like/core": "workspace:*"
  },
  "license": "MIT"
}
