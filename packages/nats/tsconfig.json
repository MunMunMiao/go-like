{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": false,
    "tsBuildInfoFile": ".artifacts/tsconfig.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../broker" }, { "path": "../context" }, { "path": "../core" }]
}
