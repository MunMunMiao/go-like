{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/nats",
  "version": "0.0.1",
  "description": "NATS Core and JetStream broker plugs for go-like.",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./broker": "./src/broker/index.ts",
    "./jetstream": "./src/jetstream/index.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.test.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test/*.test.ts",
    "test:unit:coverage": "bun test --isolate --no-orphans test/*.test.ts --coverage --coverage-dir .artifacts/coverage",
    "test:e2e:core": "bun test/e2e/core-docker-e2e.ts",
    "test:e2e:jetstream": "bun test/e2e/jetstream-docker-e2e.ts"
  },
  "dependencies": {
    "@nats-io/transport-node": "3.4.0"
  },
  "license": "MIT",
  "peerDependencies": {
    "@go-like/core": "0.0.1",
    "@nats-io/jetstream": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "@nats-io/jetstream": {
      "optional": true
    }
  },
  "devDependencies": {
    "@go-like/core": "workspace:*",
    "@nats-io/jetstream": "3.4.0",
    "@types/node": "26.6.6"
  }
}
