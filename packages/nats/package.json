{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/nats",
  "version": "0.0.1",
  "description": "Lifecycle-only go-like Server adapters for official NATS Core Subscriptions and JetStream ConsumerMessages.",
  "type": "module",
  "module": "src/index.ts",
  "typings": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./broker": "./src/broker.ts",
    "./jetstream": "./src/jetstream.ts",
    "./jetstream/broker": "./src/jetstream-broker.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.test.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test/*.test.ts",
    "test:unit:coverage": "bun test --isolate --no-orphans test/*.test.ts --coverage --coverage-dir .artifacts/coverage",
    "test:e2e:core": "bun test/e2e/core-docker-e2e.ts",
    "test:e2e:jetstream": "bun test/e2e/jetstream-docker-e2e.ts"
  },
  "dependencies": {
    "@go-like/broker": "0.0.1",
    "@go-like/context": "0.0.1",
    "@go-like/core": "0.0.1",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@types/node": "26.4.0"
  },
  "license": "MIT"
}
