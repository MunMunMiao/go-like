{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/bullmq",
  "version": "0.0.1",
  "description": "BullMQ job-queue plug for go-like.",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./job": "./src/job/index.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.test.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test/*.test.ts",
    "test:unit:coverage": "bun test --isolate --no-orphans test/*.test.ts --coverage --coverage-dir .artifacts/coverage",
    "test:e2e": "bun test/e2e/docker-e2e.ts",
    "test:e2e:job": "bun test/e2e/docker-e2e.ts",
    "test:e2e:runtimes": "tsx test/e2e/package-runtime.ts"
  },
  "license": "MIT",
  "peerDependencies": {
    "@go-like/core": "0.0.1",
    "bullmq": "^6.7.5"
  },
  "devDependencies": {
    "@go-like/core": "workspace:*",
    "@types/node": "26.6.6",
    "bullmq": "6.7.5"
  }
}
