{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@likego/bullmq",
  "version": "0.0.1",
  "description": "Lifecycle-only Servers for application-configured BullMQ Workers.",
  "type": "module",
  "module": "src/index.ts",
  "typings": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "test": "bun test --isolate --no-orphans test/*.test.ts",
    "test:coverage": "bun test --isolate --no-orphans test/*.test.ts --coverage --coverage-reporter=lcov --coverage-dir .artifacts/coverage && bun test/coverage-contract.ts",
    "typecheck": "tsc -p tsconfig.test.json --pretty false",
    "smoke:node": "tsx test/smoke/package-smoke.ts",
    "e2e:docker": "bun test/e2e/docker-e2e.ts"
  },
  "dependencies": {
    "@likego/context": "0.0.1",
    "@likego/core": "0.0.1",
    "@types/node": "26.1.1",
    "bullmq": "5.81.2"
  },
  "license": "MIT"
}
