{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/web",
  "version": "0.0.1",
  "description": "Portable standard Web handler bridge and managed Node host for go-like.",
  "type": "module",
  "module": "src/index.ts",
  "typings": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./health": "./src/health.ts",
    "./node": "./src/node.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.test.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test",
    "test:unit:coverage": "bun test --isolate --no-orphans test --coverage --coverage-dir .artifacts/coverage",
    "test:e2e": "tsx test/e2e/native-e2e.ts",
    "test:e2e:bridge-dist": "bun test/e2e/bridge-dist-e2e.ts",
    "test:e2e:runtimes": "bun test/e2e/portable-runtime.ts && tsx test/e2e/portable-runtime.ts && tsx test/e2e/node-dist-runtime.ts && deno run --sloppy-imports --config ../../deno.json test/e2e/portable-runtime.ts"
  },
  "dependencies": {
    "@go-like/context": "0.0.1",
    "@go-like/core": "0.0.1",
    "@go-like/health": "0.0.1",
    "@types/node": "26.4.0"
  },
  "license": "MIT"
}
