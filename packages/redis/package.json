{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/redis",
  "version": "0.0.1",
  "description": "Redis cache plug for go-like.",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./cache": "./src/cache/index.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.test.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test/*.test.ts",
    "test:unit:coverage": "bun test --isolate --no-orphans test/*.test.ts --coverage --coverage-dir .artifacts/coverage",
    "test:e2e": "bun test/e2e/redis-docker.ts",
    "test:e2e:cache": "bun test/e2e/redis-docker.ts"
  },
  "dependencies": {
    "@redis/client": "6.3.1"
  },
  "peerDependencies": {
    "@go-like/core": "0.0.1"
  },
  "devDependencies": {
    "@go-like/core": "workspace:*",
    "@types/node": "26.6.6"
  },
  "license": "MIT"
}
