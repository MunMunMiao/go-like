{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/file",
  "version": "0.0.1",
  "description": "Portable file store plug and Node filesystem host for go-like.",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./store": "./src/store/index.ts",
    "./store/node": "./src/store/node/index.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.test.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test/*.test.ts",
    "test:unit:coverage": "bun test --isolate --no-orphans test/*.test.ts --coverage --coverage-dir .artifacts/coverage"
  },
  "peerDependencies": {
    "@go-like/core": "0.0.1"
  },
  "devDependencies": {
    "@go-like/core": "workspace:*",
    "@types/node": "26.6.6"
  },
  "license": "MIT"
}
