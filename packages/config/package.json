{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@likego/config",
  "version": "0.0.1",
  "description": "Portable immutable configuration orchestration and explicit Node file capability for LikeGo.",
  "type": "module",
  "module": "src/index.ts",
  "typings": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./file": "./src/file.ts",
    "./node": "./src/node.ts",
    "./yaml": "./src/yaml.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "test": "bun test --isolate --no-orphans test/*.test.ts",
    "test:coverage": "bun test --isolate --no-orphans test/*.test.ts --coverage --coverage-reporter=lcov --coverage-dir .artifacts/coverage && bun test/coverage-contract.ts",
    "typecheck": "tsc -p tsconfig.test.json --pretty false",
    "smoke:node": "tsx test/runtime/node-file-runtime.ts"
  },
  "dependencies": {
    "@likego/context": "0.0.1",
    "@likego/core": "0.0.1",
    "@standard-schema/spec": "1.1.0",
    "js-yaml": "5.2.2"
  },
  "devDependencies": {
    "@types/node": "26.1.1"
  },
  "license": "MIT"
}
