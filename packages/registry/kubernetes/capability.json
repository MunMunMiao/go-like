{
  "schemaVersion": 2,
  "package": "@likego/registry-kubernetes",
  "packageKind": "portable",
  "stability": "provisional",
  "releaseBlocking": true,
  "exports": {
    ".": {
      "kind": "portable",
      "residency": "resident",
      "ownerResources": ["kubernetes-watcher"],
      "capabilities": ["registry", "registry-kubernetes", "service-discovery"],
      "runtimes": [
        {
          "runtime": "bun",
          "lane": "exact",
          "minimumVersion": "1.3.14",
          "testedVersions": ["1.3.14"],
          "terminalObservability": "observable"
        },
        {
          "runtime": "node",
          "lane": "lts",
          "minimumVersion": "24.18.0",
          "testedVersions": ["24.18.0"],
          "terminalObservability": "observable"
        },
        {
          "runtime": "node",
          "lane": "current",
          "minimumVersion": "26.5.0",
          "testedVersions": ["26.5.0"],
          "terminalObservability": "observable"
        },
        {
          "runtime": "deno",
          "lane": "exact",
          "minimumVersion": "2.9.4",
          "testedVersions": ["2.9.4"],
          "terminalObservability": "observable"
        }
      ]
    }
  }
}
