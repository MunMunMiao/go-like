{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/registry-etcd",
  "version": "0.0.1",
  "description": "Standard Web Fetch etcd v3 service registry and discovery for go-like.",
  "type": "module",
  "module": "src/index.ts",
  "typings": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.test.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test/*.test.ts",
    "test:unit:coverage": "bun test --isolate --no-orphans test/*.test.ts --coverage --coverage-reporter=lcov --coverage-dir .artifacts/coverage",
    "test:e2e": "bun test/e2e/etcd-docker.ts",
    "test:e2e:runtimes": "bun test/e2e/runtime.ts && tsx test/e2e/runtime.ts && deno run --sloppy-imports --config ../../../deno.json test/e2e/runtime.ts"
  },
  "dependencies": {
    "@go-like/context": "0.0.1",
    "@go-like/core": "0.0.1",
    "@go-like/registry": "0.0.1"
  },
  "license": "MIT"
}
