{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@likego/registry-zookeeper",
  "version": "0.0.1",
  "description": "Node and Bun ZooKeeper service registry and discovery for LikeGo.",
  "type": "module",
  "module": "src/index.ts",
  "typings": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "test": "bun test --isolate --no-orphans test/*.test.ts",
    "test:coverage": "bun test --isolate --no-orphans test/*.test.ts --coverage --coverage-reporter=lcov --coverage-dir .artifacts/coverage && bun test/coverage-contract.ts",
    "test:docker": "bun test/integration/zookeeper-docker.ts",
    "test:runtime": "bun run build && bun test/integration/published-runtime.ts",
    "typecheck": "tsc -p tsconfig.test.json --pretty false"
  },
  "dependencies": {
    "@likego/context": "0.0.1",
    "@likego/core": "0.0.1",
    "@likego/registry": "0.0.1",
    "node-zookeeper-client": "1.1.3"
  },
  "devDependencies": {
    "@types/node-zookeeper-client": "1.1.0"
  },
  "license": "MIT"
}
