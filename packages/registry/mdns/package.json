{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@likego/registry-mdns",
  "version": "0.0.1",
  "description": "Portable mDNS Registry provider and explicit Node multicast host for LikeGo.",
  "type": "module",
  "module": "src/index.ts",
  "typings": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "test": "bun test --isolate --no-orphans test",
    "test:coverage": "bun test --isolate --no-orphans test --coverage --coverage-reporter=lcov --coverage-dir .artifacts/coverage && bun test/coverage-contract.ts",
    "test:docker": "bun test/e2e/docker-e2e.ts",
    "typecheck": "tsc -p tsconfig.test.json --pretty false",
    "smoke:bun": "bun test/runtime/portable-runtime.ts",
    "smoke:node": "tsx test/runtime/portable-runtime.ts",
    "smoke:node-host": "tsx test/runtime/node-runtime.ts",
    "smoke:deno": "deno run --sloppy-imports --config ../../../deno.json test/runtime/portable-runtime.ts"
  },
  "dependencies": {
    "@likego/context": "0.0.1",
    "@likego/core": "0.0.1",
    "@likego/registry": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "26.1.1"
  },
  "license": "MIT"
}
