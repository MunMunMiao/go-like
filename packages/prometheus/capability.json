          "testedVersions": ["24.18.0"],
          "terminalObservability": "not-applicable"
        },
        {
          "runtime": "node",
          "lane": "current",
          "minimumVersion": "26.5.0",
          "testedVersions": ["26.5.0"],
          "terminalObservability": "not-applicable"
        }
      ]
    }
  }
}
