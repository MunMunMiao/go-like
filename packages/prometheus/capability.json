{
  "schemaVersion": 2,
  "package": "@likego/prometheus",
  "packageKind": "integration",
  "stability": "provisional",
  "releaseBlocking": true,
  "exports": {
    ".": {
      "kind": "integration",
      "residency": "non-resident",
      "ownerResources": [],
