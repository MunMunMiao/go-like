{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/prometheus",
  "version": "0.0.1",
  "description": "Application-owned prom-client registries and explicit go-like request instrumentation.",
  "type": "module",
  "module": "src/index.ts",
  "typings": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.test.json --pretty false && tsc -p tsconfig.e2e.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test/*.test.ts",
    "test:unit:coverage": "bun test --isolate --no-orphans test/*.test.ts --coverage --coverage-reporter=lcov --coverage-dir .artifacts/coverage",
    "test:e2e:runtimes": "bun test/e2e/runtime.ts && tsx test/e2e/runtime.ts && node ../../e2e/scripts/prometheus-native.ts"
  },
  "dependencies": {
    "@go-like/broker": "0.0.1",
    "@go-like/client": "0.0.1",
    "@go-like/context": "0.0.1",
    "@go-like/server": "0.0.1",
    "@go-like/struct": "0.0.1",
    "@go-like/transport": "0.0.1",
    "@go-like/web": "0.0.1",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2"
  },
  "license": "MIT"
}
