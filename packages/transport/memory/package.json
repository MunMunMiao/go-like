{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/transport-memory",
  "version": "0.0.1",
  "description": "Portable process-local transport for go-like internal services.",
  "type": "module",
  "module": "src/index.ts",
  "typings": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.test.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test/*.test.ts",
    "test:unit:coverage": "bun test --isolate --no-orphans test/*.test.ts --coverage --coverage-dir .artifacts/coverage",
    "test:e2e:runtimes": "bun test/e2e/portable-runtime.ts && tsx test/e2e/portable-runtime.ts && deno run --sloppy-imports --config ../../../deno.json test/e2e/portable-runtime.ts && tsx test/e2e/package-runtime.ts"
  },
  "dependencies": {
    "@go-like/context": "0.0.1",
    "@go-like/metadata": "0.0.1",
    "@go-like/transport": "0.0.1"
  },
  "license": "MIT"
}
