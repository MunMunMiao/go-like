{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/transport",
  "version": "0.0.1",
  "description": "Portable internal service transport contracts for go-like.",
  "type": "module",
  "module": "src/index.ts",
  "typings": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./headers": "./src/headers.ts",
    "./json": "./src/json.ts",
    "./provider": "./src/provider.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.test.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans --path-ignore-patterns=http --path-ignore-patterns=memory test/*.test.ts",
    "test:unit:coverage": "bun test --isolate --no-orphans --path-ignore-patterns=http --path-ignore-patterns=memory test/*.test.ts --coverage --coverage-dir .artifacts/coverage",
    "test:e2e:runtimes": "bun test/e2e/package-runtime.ts && tsx test/e2e/package-runtime.ts && deno run --sloppy-imports --config ../../deno.json test/e2e/package-runtime.ts"
  },
  "dependencies": {
    "@go-like/context": "0.0.1",
    "@go-like/metadata": "0.0.1",
    "@go-like/struct": "0.0.1"
  },
  "license": "MIT"
}
