{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/transport-grpc-buf",
  "version": "0.0.1",
  "description": "Portable Connect/gRPC-Web bridge and managed standard-gRPC owners for go-like Buf services.",
  "type": "module",
  "module": "src/index.ts",
  "typings": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./native": "./src/native.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "test:e2e:runtimes": "bun run --cwd ../../.. proto:generate && bun test/e2e/portable-runtime.ts && tsx test/e2e/portable-runtime.ts",
    "typecheck": "tsc -p tsconfig.test.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test/*.test.ts",
    "test:unit:coverage": "bun test --isolate --no-orphans test/*.test.ts --coverage --coverage-dir .artifacts/coverage"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-node": "2.3.0",
    "@go-like/client": "0.0.1",
    "@go-like/context": "0.0.1",
    "@go-like/core": "0.0.1",
    "@go-like/metadata": "0.0.1",
    "@go-like/registry": "0.0.1",
    "@go-like/transport": "0.0.1",
    "@types/node": "26.6.5"
  },
  "devDependencies": {
    "@connectrpc/connect-web": "2.3.0",
    "@go-like/web": "workspace:*"
  },
  "license": "MIT"
}
