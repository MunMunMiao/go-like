{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/rabbitmq",
  "version": "0.0.1",
  "description": "RabbitMQ broker plug for go-like.",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./broker": "./src/broker/index.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.test.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test/*.test.ts",
    "test:unit:coverage": "bun test --isolate --no-orphans test/*.test.ts --coverage --coverage-dir .artifacts/coverage",
    "test:e2e": "bun test/e2e/rabbitmq-docker-e2e.ts",
    "test:e2e:broker": "bun test/e2e/rabbitmq-docker-e2e.ts"
  },
  "peerDependencies": {
    "@go-like/core": "0.0.1",
    "amqplib": "^2.3.1"
  },
  "peerDependenciesMeta": {
    "amqplib": {
      "optional": true
    }
  },
  "devDependencies": {
    "@go-like/core": "workspace:*",
    "@types/node": "26.6.6",
    "amqplib": "2.3.1"
  },
  "license": "MIT"
}
