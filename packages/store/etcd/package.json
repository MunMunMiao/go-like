{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/store-etcd",
  "version": "0.0.1",
  "description": "Portable etcd v3 JSON gateway Store provider using standard Web Fetch for go-like.",
  "type": "module",
  "module": "src/index.ts",
  "typings": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.test.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test/*.test.ts",
    "test:unit:coverage": "bun test --isolate --no-orphans test/*.test.ts --coverage --coverage-reporter=lcov --coverage-dir .artifacts/coverage",
    "test:e2e": "bun test/e2e/etcd-docker.ts",
    "test:e2e:runtimes": "bun test/e2e/runtime-matrix.ts"
  },
  "dependencies": {
    "@go-like/context": "0.0.1",
    "@go-like/core": "0.0.1",
    "@go-like/store": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "26.1.2"
  },
  "license": "MIT"
}
