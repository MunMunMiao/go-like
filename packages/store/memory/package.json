{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/store-memory",
  "version": "0.0.1",
  "description": "Portable process-local Store provider for go-like.",
  "type": "module",
  "module": "src/index.ts",
  "typings": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.test.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test",
    "test:unit:coverage": "bun test --isolate --no-orphans test --coverage --coverage-dir .artifacts/coverage"
  },
  "dependencies": {
    "@go-like/context": "0.0.1",
    "@go-like/store": "0.0.1"
  },
  "license": "MIT"
}
