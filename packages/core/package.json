{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/core",
  "version": "0.0.1",
  "description": "Portable application lifecycle, context, struct, registry, config, cache, store, broker, transport, server, client, and web host for go-like.",
  "type": "module",
  "module": "src/index.ts",
  "typings": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts",
    "./lifecycle": "./src/lifecycle/index.ts",
    "./telemetry": "./src/telemetry/index.ts",
    "./telemetry/provider": "./src/telemetry/provider.ts",
    "./log": "./src/log/index.ts",
    "./trace": "./src/trace/index.ts",
    "./metric": "./src/metric/index.ts",
    "./context": "./src/context/index.ts",
    "./metadata": "./src/metadata/index.ts",
    "./struct": "./src/struct/index.ts",
    "./health": "./src/health/index.ts",
    "./resilience": "./src/resilience/index.ts",
    "./testing": "./src/testing/index.ts",
    "./transport": "./src/transport/index.ts",
    "./transport/provider": "./src/transport/provider.ts",
    "./transport/memory": "./src/transport/memory/index.ts",
    "./transport/http": "./src/transport/http/index.ts",
    "./transport/http/node": "./src/transport/http/node.ts",
    "./server": "./src/server/index.ts",
    "./client": "./src/client/index.ts",
    "./web": "./src/web/index.ts",
    "./web/node": "./src/web/node.ts",
    "./web/bun": "./src/web/bun.ts",
    "./registry": "./src/registry/index.ts",
    "./registry/provider": "./src/registry/provider.ts",
    "./registry/memory": "./src/registry/memory.ts",
    "./config": "./src/config/index.ts",
    "./config/provider": "./src/config/provider.ts",
    "./config/node": "./src/config/node.ts",
    "./fetch": "./src/fetch/index.ts",
    "./cache": "./src/cache/index.ts",
    "./cache/memory": "./src/cache/memory/index.ts",
    "./store": "./src/store/index.ts",
    "./store/provider": "./src/store/provider.ts",
    "./store/memory": "./src/store/memory/index.ts",
    "./broker": "./src/broker/index.ts",
    "./broker/provider": "./src/broker/provider.ts",
    "./broker/memory": "./src/broker/memory/index.ts",
    "./job": "./src/job/index.ts",
    "./job/provider": "./src/job/provider.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.test.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans --path-ignore-patterns=/e2e/ test",
    "test:unit:coverage": "bun test --isolate --no-orphans --path-ignore-patterns=/e2e/ test --coverage --coverage-dir .artifacts/coverage",
    "test:e2e:transport": "bun test/e2e/transport-http-node-security.ts",
    "test:e2e:web-native": "tsx test/e2e/web-native-e2e.ts",
    "test:e2e:runtimes": "bun test --isolate --no-orphans test/e2e/*.test.ts && bun test/e2e/package-runtime.ts && tsx test/e2e/package-runtime.ts && bun test/e2e/transport-package-runtime.ts && tsx test/e2e/transport-package-runtime.ts && bun test/e2e/transport-http-portable-runtime.ts && tsx test/e2e/transport-http-portable-runtime.ts && tsx test/e2e/transport-http-package-runtime.ts && bun test/e2e/transport-memory-portable-runtime.ts && tsx test/e2e/transport-memory-portable-runtime.ts && tsx test/e2e/transport-memory-package-runtime.ts && bun test/e2e/web-portable-runtime.ts && tsx test/e2e/web-portable-runtime.ts && tsx test/e2e/web-node-dist-runtime.ts && bun test/e2e/web-native-host-e2e.ts && bun test/e2e/config-dist-runtime.ts && tsx test/e2e/config-dist-runtime.ts && tsx test/e2e/config-node-file-runtime.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6"
  },
  "license": "MIT"
}
