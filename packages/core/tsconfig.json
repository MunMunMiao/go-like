{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": false,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": false,
    "tsBuildInfoFile": ".artifacts/tsconfig.tsbuildinfo",
    "types": ["node"],
    "lib": ["ES2023", "ES2024.String", "ES2024.Promise", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts"]
}
