{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/croner",
  "version": "0.0.1",
  "description": "Croner schedule plug for go-like.",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./job": "./src/job/index.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.test.json --pretty false && tsc -p tsconfig.e2e.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test/*.test.ts",
    "test:unit:coverage": "bun test --isolate --no-orphans test/*.test.ts --coverage --coverage-dir .artifacts/coverage",
    "test:e2e": "tsx test/e2e/native-e2e.ts",
    "test:e2e:runtimes": "bun test/e2e/package-runtime.ts && tsx test/e2e/package-runtime.ts"
  },
  "dependencies": {
    "croner": "11.0.0"
  },
  "license": "MIT",
  "peerDependencies": {
    "@go-like/core": "0.0.1"
  },
  "devDependencies": {
    "@go-like/core": "workspace:*"
  }
}
