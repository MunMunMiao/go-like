{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/cache",
  "version": "0.0.1",
  "description": "Portable Go-style Cache contracts for go-like.",
  "type": "module",
  "module": "src/index.ts",
  "typings": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./provider": "./src/provider.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.test.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test",
    "test:unit:coverage": "bun test --isolate --no-orphans test --coverage --coverage-reporter=lcov --coverage-dir .artifacts/coverage"
  },
  "dependencies": {
    "@go-like/context": "0.0.1"
  },
  "devDependencies": {
    "@go-like/core": "workspace:*"
  },
  "license": "MIT"
}
