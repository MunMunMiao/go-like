{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@likego/cache-redis",
  "version": "0.0.1",
  "description": "Lifecycle-owned Redis Cache provider for LikeGo using the official node-redis client.",
  "type": "module",
  "module": "src/index.ts",
  "typings": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.test.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test/*.test.ts",
    "test:unit:coverage": "bun test --isolate --no-orphans test/*.test.ts --coverage --coverage-reporter=lcov --coverage-dir .artifacts/coverage",
    "test:e2e": "bun test/e2e/redis-docker.ts"
  },
  "dependencies": {
    "@likego/cache": "0.0.1",
    "@likego/context": "0.0.1",
    "@likego/core": "0.0.1",
    "@redis/client": "6.1.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1"
  },
  "license": "MIT"
}
