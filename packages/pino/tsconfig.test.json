{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": {
      "@go-like/pino": ["./src/index.ts"],
      "@go-like/broker": ["../../packages/broker/src/index.ts"],
      "@go-like/client": ["../../packages/client/src/index.ts"],
      "@go-like/context": ["../../packages/context/src/index.ts"],
      "@go-like/core": ["../../packages/core/src/index.ts"],
      "@go-like/core/lifecycle": ["../../packages/core/src/lifecycle.ts"],
      "@go-like/server": ["../../packages/server/src/index.ts"],
      "@go-like/struct": ["../../packages/struct/src/index.ts"],
      "@go-like/struct/codec": ["../../packages/struct/src/codec/index.ts"],
      "@go-like/struct/runtime": ["../../packages/struct/src/introspection.ts"],
      "@go-like/transport": ["../../packages/transport/src/index.ts"],
      "@go-like/transport/headers": ["../../packages/transport/src/headers.ts"],
      "@go-like/transport/json": ["../../packages/transport/src/json.ts"]
