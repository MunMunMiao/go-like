{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@likego/pino",
  "version": "0.0.1",
  "description": "Native Pino lifecycle and request logging adapters for LikeGo.",
  "type": "module",
  "module": "src/index.ts",
  "typings": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.test.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test/*.test.ts",
    "test:unit:coverage": "bun test --isolate --no-orphans test/*.test.ts --coverage --coverage-reporter=lcov --coverage-dir .artifacts/coverage",
    "test:e2e:runtimes": "bun test/e2e/runtime.ts && tsx test/e2e/runtime.ts && bun x tsx test/e2e/native-e2e.ts"
  },
  "dependencies": {
    "@likego/broker": "0.0.1",
    "@likego/client": "0.0.1",
    "@likego/context": "0.0.1",
    "@likego/core": "0.0.1",
    "@likego/server": "0.0.1",
    "@likego/transport": "0.0.1",
    "@types/node": "26.1.1",
    "pino": "10.3.1"
  },
  "license": "MIT"
}
