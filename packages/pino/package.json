{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/pino",
  "version": "0.0.1",
  "description": "Native Pino lifecycle and request logging adapters for go-like.",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./log": "./src/log/index.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.test.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test/*.test.ts",
    "test:unit:coverage": "bun test --isolate --no-orphans test/*.test.ts --coverage --coverage-dir .artifacts/coverage",
    "test:e2e:runtimes": "bun test/e2e/runtime.ts && tsx test/e2e/runtime.ts && tsx test/e2e/native-e2e.ts"
  },
  "dependencies": {
    "@types/node": "26.6.6"
  },
  "license": "MIT",
  "peerDependencies": {
    "@go-like/core": "0.0.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@go-like/core": "workspace:*",
    "pino": "10.4.0"
  }
}
