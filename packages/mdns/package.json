{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/mdns",
  "version": "0.0.1",
  "description": "Portable mDNS registry plug and Node multicast host for go-like.",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./registry": "./src/registry/index.ts",
    "./registry/node": "./src/registry/node/index.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.test.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test/*.test.ts",
    "test:unit:coverage": "bun test --isolate --no-orphans test/*.test.ts --coverage --coverage-dir .artifacts/coverage",
    "test:e2e": "bun test/e2e/docker-e2e.ts",
    "test:e2e:registry": "bun test/e2e/docker-e2e.ts",
    "test:e2e:runtimes": "bun test/e2e/portable-runtime.ts && tsx test/e2e/portable-runtime.ts && tsx test/e2e/node-runtime.ts"
  },
  "peerDependencies": {
    "@go-like/core": "0.0.1"
  },
  "devDependencies": {
    "@go-like/core": "workspace:*",
    "@types/node": "26.6.6"
  },
  "license": "MIT"
}
