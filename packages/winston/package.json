{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@go-like/winston",
  "version": "0.0.1",
  "description": "Native Winston lifecycle and request logging adapters for go-like.",
  "type": "module",
  "module": "src/index.ts",
  "typings": "src/index.ts",
  "sideEffects": false,
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun x --bun tsdown --config-loader native",
    "typecheck": "tsc -p tsconfig.test.json --pretty false",
    "test:unit": "bun test --isolate --no-orphans test/*.test.ts",
    "test:unit:coverage": "bun test --isolate --no-orphans test/*.test.ts --coverage --coverage-dir .artifacts/coverage",
    "test:e2e:runtimes": "bun test/e2e/runtime.ts && tsx test/e2e/runtime.ts && bun x tsx ../../e2e/scripts/winston-native.ts"
  },
  "dependencies": {
    "@go-like/broker": "0.0.1",
    "@go-like/client": "0.0.1",
    "@go-like/context": "0.0.1",
    "@go-like/core": "0.0.1",
    "@go-like/server": "0.0.1",
    "@go-like/struct": "0.0.1",
    "@go-like/transport": "0.0.1",
    "@go-like/web": "0.0.1",
    "@types/node": "26.1.2",
    "winston": "3.19.0"
  },
  "license": "MIT"
}
