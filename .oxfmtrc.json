{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "proseWrap": "preserve",
  "semi": false,
  "singleQuote": false,
  "sortPackageJson": false,
  "trailingComma": "none",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/.artifacts/**",
    "**/reports/**",
    "**/test-build/**",
    ".git/**",
    ".idea/**",
    ".vscode/**",
    "**/.omo/**",
    "**/evidence/**",
    "docs/superpowers/**",
    "**/fixtures/**",
    "**/probes/**",
    "tmp/**",
    "temp/**",
    "vendor/**",
    "external/**",
    "**/*.tmp",
    "**/*.tmp.*",
    "**/*.temp",
    "**/*.temp.*",
    "**/*-report.md",
    "docs/file-inventory.md"
  ]
}
