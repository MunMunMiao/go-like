{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://likego.dev/schemas/capability-manifest.schema.json",
  "title": "LikeGo capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "package",
    "packageKind",
    "stability",
    "releaseBlocking",
    "residency",
    "capabilities",
    "runtimes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "package": { "type": "string", "pattern": "^@likego/[a-z0-9][a-z0-9-]*$" },
    "packageKind": { "enum": ["portable", "adapter"] },
    "stability": { "enum": ["provisional", "beta", "stable"] },
    "releaseBlocking": { "type": "boolean" },
    "residency": { "enum": ["non-resident", "resident"] },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "runtimes": {
      "type": "array",
      "items": { "$ref": "#/$defs/runtime" }
    }
  },
  "$defs": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "lane",
        "minimumVersion",
        "testedVersions",
        "terminalObservability"
      ],
      "properties": {
        "runtime": { "enum": ["bun", "node", "deno"] },
        "lane": { "enum": ["exact", "lts", "current"] },
        "minimumVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
        },
        "testedVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
          }
        },
        "terminalObservability": {
          "enum": ["not-applicable", "observable", "unobservable"]
        }
      }
    }
  }
}
