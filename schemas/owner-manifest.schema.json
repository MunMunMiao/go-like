{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://likego.dev/schemas/owner-manifest.schema.json",
  "title": "LikeGo owner manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "package", "resources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "package": { "type": "string", "pattern": "^@likego/[a-z0-9][a-z0-9-]*$" },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/resource" }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "exposure", "stopContract"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "owner": { "enum": ["likego-owned", "application-owned"] },
        "exposure": { "enum": ["managed-private", "native-borrowed"] },
        "stopContract": { "enum": ["likego-owned", "application-owned"] }
      }
    }
  }
}
